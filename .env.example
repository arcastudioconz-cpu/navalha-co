# ------------------------------------------------------------------
# Navalha & Co — environment configuration
# Copy this file to ".env" and fill in real values before deploying.
# ------------------------------------------------------------------

# Port the server listens on
PORT=3000

# Secret used to sign admin session cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# The FIRST time the server starts it creates the admin login from this
# password. Change it here BEFORE first launch, then log in and you can
# update it from the dashboard. Do not leave the default in production.
ADMIN_PASSWORD=changeme-admin

# Where the SQLite database file lives. On a host with a persistent disk
# (Render/Railway/Fly), point this at that disk so bookings survive deploys.
DATABASE_PATH=./data/navalha.db

# ---- Optional: automated WhatsApp sending via Twilio --------------
# Leave blank to use click-to-send wa.me links (works with zero setup).
# Fill these in to send confirmations automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
